{
	"name": "pluginever/ever-blocks",
	"description": "Gutenberg blocks with the design and control depth core leaves out.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "ByteEver",
			"email": "info@byteever.com"
		}
	],
	"minimum-stability": "stable",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"byteever/byteever-sniffs": "^1.1.3",
		"php-stubs/wordpress-stubs": "^7.1",
		"phpstan/php-8-stubs": "^0.4.35",
		"szepeviktor/phpstan-wordpress": "^2.0.4",
		"wp-phpunit/wp-phpunit": "^7.0",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"autoload": {
		"psr-4": {
			"EverBlocks\\": "includes/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.4"
		},
		"sort-packages": true
	},
	"scripts": {
		"phpcs": "phpcs --standard=phpcs.xml -s",
		"phpcbf": "phpcbf --standard=phpcs.xml",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"makepot": "wp i18n make-pot . languages/ever-blocks.pot --domain=ever-blocks --exclude=node_modules,vendor,src,sources --skip-audit",
		"test": "phpunit",
		"test:setup": "bash ./tests/bin/install.sh ever_blocks_test root root 127.0.0.1 7.1"
	},
	"autoload-dev": {
		"psr-4": {
			"EverBlocks\\Tests\\": "tests/phpunit/"
		}
	}
}
