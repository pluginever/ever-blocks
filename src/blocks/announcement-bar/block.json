{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ever-blocks/announcement-bar",
	"title": "Announcement Bar",
	"category": "ever-blocks",
	"icon": "megaphone",
	"description": "A bar for notices and promotions — still, scrolling, or rotating — that visitors can dismiss.",
	"keywords": [
		"notification",
		"banner",
		"top bar",
		"promo",
		"marquee",
		"announcement"
	],
	"textdomain": "ever-blocks",
	"attributes": {
		"animation": {
			"type": "string",
			"default": "static",
			"enum": [
				"static",
				"ticker",
				"rotate"
			]
		},
		"speed": {
			"type": "string",
			"default": "normal",
			"enum": [
				"slow",
				"normal",
				"fast"
			]
		},
		"direction": {
			"type": "string",
			"default": "left",
			"enum": [
				"left",
				"right",
				"up",
				"down"
			]
		},
		"dismissible": {
			"type": "boolean",
			"default": false
		},
		"rememberDays": {
			"type": "number",
			"default": 7
		},
		"startsAt": {
			"type": "string",
			"default": ""
		},
		"endsAt": {
			"type": "string",
			"default": ""
		},
		"closeIcon": {
			"type": "string",
			"default": "heroicons/x-mark"
		},
		"separator": {
			"type": "string",
			"default": "dot",
			"enum": [
				"none",
				"dot",
				"line",
				"slash",
				"custom"
			]
		},
		"separatorText": {
			"type": "string",
			"default": ""
		}
	},
	"allowedBlocks": [
		"ever-blocks/announcement"
	],
	"supports": {
		"html": false,
		"anchor": true,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"text": true,
			"background": true,
			"gradients": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"style": true,
				"width": true
			}
		},
		"position": {
			"sticky": true
		},
		"interactivity": true,
		"everBlocks": {
			"elements": {
				"track": ".eb-announcement-bar__track",
				"close": {
					"selector": ".eb-announcement-bar__close",
					"states": [
						":hover",
						":focus-visible"
					]
				},
				"separator": ".eb-announcement-bar__track .eb-announcement::after"
			}
		}
	},
	"selectors": {
		"root": ".eb-announcement-bar",
		"states": {
			"-paused": ".eb-announcement-bar.is-paused"
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": [
		"ever-blocks-common",
		"file:./style-index.css"
	],
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
