{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ever-blocks/accordion",
	"title": "Accordion",
	"category": "ever-blocks",
	"icon": "list-view",
	"description": "Collapsible panels for FAQs and long content, with optional FAQ schema.",
	"keywords": [ "accordion", "faq", "toggle", "collapse", "details" ],
	"textdomain": "ever-blocks",
	"attributes": {
		"allowMultiple": {
			"type": "boolean",
			"default": false
		},
		"icon": {
			"type": "string",
			"default": "core/chevron-down"
		},
		"iconOpen": {
			"type": "string",
			"default": ""
		},
		"iconPosition": {
			"type": "string",
			"default": "right",
			"enum": [ "left", "right" ]
		},
		"schema": {
			"type": "boolean",
			"default": false
		}
	},
	"providesContext": {
		"ever-blocks/accordionIcon": "icon",
		"ever-blocks/accordionIconOpen": "iconOpen",
		"ever-blocks/accordionIconPosition": "iconPosition"
	},
	"allowedBlocks": [ "ever-blocks/accordion-item" ],
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"color": {
			"text": true,
			"background": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"everBlocks": {}
	},
	"selectors": {
		"root": ".eb-accordion"
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
