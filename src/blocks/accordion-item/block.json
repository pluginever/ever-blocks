{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ever-blocks/accordion-item",
	"title": "Accordion Item",
	"category": "ever-blocks",
	"icon": "arrow-down-alt2",
	"description": "One collapsible panel inside an accordion.",
	"textdomain": "ever-blocks",
	"parent": [
		"ever-blocks/accordion"
	],
	"attributes": {
		"title": {
			"type": "string",
			"role": "content",
			"default": ""
		},
		"open": {
			"type": "boolean",
			"default": false
		},
		"level": {
			"type": "number",
			"default": 3
		}
	},
	"usesContext": [
		"ever-blocks/accordionIcon",
		"ever-blocks/accordionIconOpen",
		"ever-blocks/accordionIconPosition"
	],
	"supports": {
		"html": false,
		"anchor": true,
		"color": {
			"text": true,
			"background": true
		},
		"spacing": {
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"everBlocks": {
			"elements": {
				"summary": {
					"selector": ".eb-accordion-item__summary",
					"states": [
						":hover",
						":focus-visible"
					]
				},
				"title": ".eb-accordion-item__title",
				"icon": ".eb-accordion-item__icon",
				"panel": ".eb-accordion-item__panel"
			}
		}
	},
	"selectors": {
		"root": ".eb-accordion-item",
		"states": {
			"-open": ".eb-accordion-item[open]"
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": [
		"ever-blocks-common",
		"file:./style-index.css"
	],
	"render": "file:./render.php"
}
