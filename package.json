{
	"name": "ever-blocks",
	"version": "2.0.0",
	"private": true,
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"preinstall": "[ \"$INIT_CWD\" != \"$PWD\" ] || npx only-allow pnpm",
		"start": "wp-scripts start --experimental-modules --blocks-manifest",
		"build": "wp-scripts build --experimental-modules --blocks-manifest",
		"typecheck": "tsc -b",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"format": "wp-scripts format",
		"makepot": "composer run makepot",
		"build:icons": "pnpm --filter @byteever/block-components codegen:icons --out assets/icons --domain ever-blocks",
		"test:unit": "wp-scripts test-unit-js --config jest.config.js",
		"fixtures": "node tests/data/build.cjs > tests/data/styles.json"
	},
	"devDependencies": {
		"@types/react": "^19.2.18",
		"@wordpress/api-fetch": "^7.54.0",
		"@wordpress/block-editor": "^17.0.0",
		"@wordpress/blocks": "^16.0.0",
		"@wordpress/components": "^40.0.0",
		"@wordpress/compose": "^8.8.0",
		"@wordpress/hooks": "^4.55.0",
		"@wordpress/i18n": "^6.27.0",
		"@wordpress/icons": "^15.5.0",
		"@wordpress/prettier-config": "^4.31.0",
		"@wordpress/scripts": "^34.1.0",
		"@wordpress/style-engine": "^2.54.0",
		"typescript": "^6.0.3"
	}
}
