# ═══════════════════════════════════════════════════════════════════════════
# Distribution Ignore - Production Build Exclusions
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────
# Version Control
# ───────────────────────────────
.git/
.github/
.gitattributes
.gitignore

# ───────────────────────────────
# Development Tooling
# ───────────────────────────────
bin/
tests/
composer.lock
node_modules/
package.json
pnpm-lock.yaml
pnpm-workspace.yaml

# ───────────────────────────────
# Sources
# ───────────────────────────────
src/
packages/

# ───────────────────────────────
# Catch All ( Miscellaneous )
# ───────────────────────────────
*.dist
*.log
*.map
*.md
*.scss
*.sh
*.tmp
*.ts
*.tsx
*.yaml
*.yml
*.zip
.*
/*.js
/*.json
/*.xml
phpunit.xml
tools/
