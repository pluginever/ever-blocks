# ═══════════════════════════════════════════════════════════════════════════
# Distribution Ignore - Production Build Exclusions
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────
# Version Control
# ───────────────────────────────
.git/
.github/
.gitattributes
.gitignore

# ───────────────────────────────
# Development Tooling
# ───────────────────────────────
bin/
tests/
vendor/
node_modules/
composer.lock
package.json
pnpm-lock.yaml
pnpm-workspace.yaml
phpstan-bootstrap.php
phpunit.xml

# ───────────────────────────────
# Agent Instructions
# ───────────────────────────────
.claude/
AGENTS.md
CLAUDE.md

# ───────────────────────────────
# Sources
# ───────────────────────────────
src/
packages/

# ───────────────────────────────
# Catch All ( Miscellaneous )
# ───────────────────────────────
*.dist
*.log
*.map
*.md
*.scss
*.sh
*.tmp
*.ts
*.tsx
*.yaml
*.yml
*.zip
.*
/*.js
/*.json
/*.xml